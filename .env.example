# PostgreSQL
POSTGRES_USER=vigil
POSTGRES_PASSWORD=vigil
POSTGRES_DB=vigil

# Backend
DATABASE_URL=postgresql+asyncpg://vigil:vigil@db:5432/vigil
CORS_ORIGINS=http://localhost:3000

# Required secrets — generate and set before running
# JWT signing key: openssl rand -hex 32
JWT_SECRET=
# Fernet encryption key for integration credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Session secret for OAuth CSRF state: openssl rand -hex 32
SESSION_SECRET=

# GitHub OAuth (leave empty to disable auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
